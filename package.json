{
  "name": "blockdead",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build && node tools/check-size.mjs",
    "characters": "node tools/build-characters.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "models": "node tools/optimize-models.mjs",
    "prep-models": "node tools/prep-models.mjs",
    "test:anim": "node tools/vite-run.mjs src/debug/animTest.ts",
    "test:zombies": "node tools/vite-run.mjs src/debug/zombieTest.ts",
    "test:ragdoll": "node tools/vite-run.mjs src/debug/ragdollTest.ts",
    "test:zfight": "node tools/vite-run.mjs src/debug/zfightTest.ts",
    "test:search": "node tools/vite-run.mjs src/debug/searchTest.ts",
    "test:lab": "node tools/vite-run.mjs src/debug/labTest.ts",
    "test:bigpoi": "node tools/vite-run.mjs src/debug/bigPoiTest.ts",
    "test:poi": "node tools/vite-run.mjs src/debug/poiTest.ts",
    "test:e2e": "node tools/e2e.mjs",
    "test:scenes": "node tools/vite-run.mjs src/debug/scenarioTest.ts",
    "test:hordes": "node tools/vite-run.mjs src/debug/hordeTest.ts"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@types/three": "^0.186.0",
    "jpeg-js": "^0.4.4",
    "meshoptimizer": "^1.3.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
